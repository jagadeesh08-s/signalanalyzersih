# SIH26147 Signal Analyzer - Environment Configuration
# Copy this file to .env and customize for your environment

# Application
APP_NAME="SIH26147 Signal Analyzer"
APP_VERSION="1.0.0"
DEBUG=true

# API
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database
DATABASE_URL="sqlite+aiosqlite:///./signal_analyzer.db"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=524288000
ALLOWED_EXTENSIONS=[".iq", ".IQ", ".wav", ".WAV", ".bin", ".raw"]

# Sample Signals
SAMPLE_SIGNALS_DIR="./data/samples"

# Signal Processing Defaults
DEFAULT_FFT_SIZE=4096
DEFAULT_WINDOW="hann"
MAX_VISUALIZATION_POINTS=10000

# ML Model
MODEL_PATH="./models"
CONFIDENCE_THRESHOLD=0.5

# Redis (for caching/queues)
REDIS_URL="redis://localhost:6379/0"

# Authentication
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY="sih26147-dev-key-change-in-production"
ENABLE_AUTH=false

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_API_KEY="sih26147-dev-key-change-in-production"